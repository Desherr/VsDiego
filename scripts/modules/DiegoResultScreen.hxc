import flixel.addons.display.FlxBackdrop;
import flixel.addons.display.FlxRuntimeShader;
import flixel.graphics.frames.FlxBitmapFont;
import flixel.math.FlxBasePoint;
import flixel.FlxG;
import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.play.ResultState;

//Credits of this module to the Sonic JamX coding team

class DiegoResultScreen extends Module
{
    var replacedScrollText:Bool = true;

    public function new()
    {
        super("DiegoResultScreen", 1000, {
            state: ResultState
        });
    }

    public function onUpdate(event:UpdateScriptEvent)
    {
        super.onUpdate(event);

        var state:FlxSubState = FlxG.state.subState;

        // Don't replace the texts if we have already replaced them before or the player isn't diego.
        if (replacedScrollText || state.playerCharacterId != "diego") return;

        var textsArray:Array<FlxSprite> = [];
        for (member in state.members)
        {
            if (member?.camera != state.cameraScroll || !Std.isOfType(member, FlxBackdrop)) continue;

            // Add the texts to the array so that we don't mess over state member iteration.
            textsArray.push(member);
        }

        // If there are no texts, don't do anything.
        if (textsArray.length == 0) return;

        // Set the flag to true so that we don't have to do this again.
        replacedScrollText = true;

        // Replace the texts.
        while (textsArray.length > 0)
        {
            var daText:FlxBackdrop = textsArray.shift();
            var pos:Array<Float> = [daText.x, daText.y];
            var vel:Float = daText.velocity.x;
            var img:String = "resultScreen/rankText/rankScroll" + state.rank.split("_")[0].toUpperCase() + "-sonic";

            state.members.remove(daText);
            daText.destroy();

            var newText:FlxBackdrop = new FlxBackdrop(Paths.image(img), 0x01, 10, 0);
            newText.setPosition(pos[0], pos[1]);
            newText.zIndex = 100;
            newText.cameras = [state.cameraScroll];
            newText.velocity.x = vel;
            state.add(newText);
        }

        // Refresh the state.
        state.refresh();
    }

    public function onSubStateOpenEnd(event:SubStateScriptEvent)
    {
        super.onSubStateOpenEnd(event);

        // Don't do anything if we're not in the result screen.
        if (!Std.isOfType(event.targetState, ResultState)) return;

        var state:ResultState = event.targetState;

        // Don't do anything if not Sonic.
        if (state.playerCharacterId != "sonic") return;

        // Apply a shader to many results screen elements.
        var bgShader:FlxRuntimeShader = new FlxRuntimeShader(Assets.getText(Paths.frag('addColor')));
        state.members[0].shader = bgShader;

        // Set shader values.
        // For blue (0xFF6188b1) - rgb(97 136 177)
        // For yellow (0xFFFDC05C) - rgb(253 192 92)
        bgShader.setFloat("colorRed", (97 - 253) / 255);
        bgShader.setFloat("colorGreen", (136 - 192) / 255);
        bgShader.setFloat("colorBlue", (177 - 92) / 255);

        // Reset the replaced text status so that we can replace scrolling texts again.
        replacedScrollText = false;

        // Replace the font of the text with the song name - it already has a shader so we use a different font spritesheet.
        var fontLetters:String = "AaBbCcDdEeFfGgHhiIJjKkLlMmNnOoPpQqRrSsTtUuVvWwXxYyZz:1234567890().-";
        state.songName.font = FlxBitmapFont.fromMonospace(Paths.image("resultScreen/tardlingSpritesheet-sonic"), fontLetters, FlxBasePoint.get(49, 61));
    }
}
